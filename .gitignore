# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# Data: raw corpus is reproducible from the pipeline; do not commit large files.
data/raw/*
!data/raw/.gitkeep

# Processed artifacts can be regenerated; keep the folder but ignore big binaries.
data/processed/*
!data/processed/.gitkeep

# Reports are generated by the pipeline.
reports/*
!reports/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/
