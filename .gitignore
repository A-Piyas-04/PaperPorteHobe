# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# Data: raw corpus is reproducible from the pipeline; do not commit large files.
data/raw/*
!data/raw/.gitkeep

# Processed artifacts can be regenerated; keep the folder but ignore big binaries.
data/processed/*
!data/processed/.gitkeep

# Pipeline stage outputs, embedding cache, published releases and the DuckDB store.
data/stages/
data/releases/
*.duckdb
*.duckdb.wal

# Local secrets and tool caches
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml

# Reports are generated by the pipeline.
reports/*
!reports/.gitkeep

# Explorer component: commit the built dist/, never node_modules.
app/components/explorer/frontend/node_modules/
*.log

# OS / editor
.DS_Store
.idea/
.vscode/
